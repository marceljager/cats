{
  // type checking for the site's own .js modules, which opt in with // @ts-check (npm run check);
  // not strict: it reports wrong types, not missing annotations
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*"]
}
